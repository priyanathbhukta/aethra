# ==============================================================================
# AETHRA Environment Configuration Template
# ==============================================================================

# Node Environment
NODE_ENV=development
LOG_LEVEL=debug
APP_PORT=3000

# AWS Region
AWS_REGION=ap-south-1

# PostgreSQL Cluster (Local Docker)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgrespassword
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis Cache & Queues (Local Docker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka / Redpanda Broker (Local Docker)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=aethra-platform
KAFKA_GROUP_ID_PREFIX=aethra-group
KAFKA_SSL=false

# AWS S3 / Local MinIO Object Storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET_NAME=aethra-documents-local
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Authentication & OIDC (AWS Cognito / Mock OIDC)
OIDC_ISSUER_URL=https://cognito-idp.ap-south-1.amazonaws.com/ap-south-1_MOCK1234
OIDC_CLIENT_ID=mock-client-id
OIDC_AUDIENCE=aethra-api
JWT_SECRET=super-secret-dev-jwt-key-replace-in-production-min-32-chars

# OpenTelemetry Tracing
OTEL_SERVICE_NAME=aethra-gateway
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER=always_on
